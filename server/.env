# # PostgreSQL connection string
# DATABASE_URL=postgres://user:password@localhost:5432/proposal

# # Set to "false" to disable SSL for local Postgres (managed providers usually need SSL, the default)
# PGSSL=true

DATABASE_URL=postgres://postgres:postgres@localhost:5433/proposal
PGSSL=false

# Password for the /admin login page
DASHBOARD_PASSWORD=rafi

# Long random string used to sign the admin login cookie — required for /admin to work.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: webhook (Slack/Discord/etc incoming webhook URL) pinged on every session_start
NOTIFY_WEBHOOK_URL=

PORT=3000
